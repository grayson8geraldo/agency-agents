# Crypto MTFA Bot — Environment Configuration
# Copy to .env and fill in your values

# Exchange API (default: Binance Futures)
EXCHANGE_ID=binanceusdm
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_API_SECRET=your_api_secret_here

# Trading pair
SYMBOL=BTC/USDT:USDT

# Timeframes
HTF_TIMEFRAME=1d
MTF_TIMEFRAME=1h
LTF_TIMEFRAME=15m

# Risk Management
RISK_PER_TRADE_PCT=1.0
TP_MODE=STATIC
RR_RATIO=3.0
MAX_DAILY_LOSS_PCT=3.0
MAX_CONSECUTIVE_LOSSES=3

# Guardrails
CHOP_ZONE_LOW=0.45
CHOP_ZONE_HIGH=0.55
COOLDOWN_CANDLES=20
SL_BUFFER_PCT=0.05

# Structure detection
SWING_LOOKBACK=3
MIN_BOS_DISTANCE_PCT=0.5
MIN_DISPLACEMENT_PCT=1.5
EQUAL_LEVEL_TOLERANCE_PCT=0.1
MAX_OB_AGE_CANDLES=100

# LTF Execution
MAX_CONFLUENCE_WINDOW=12
PIN_BAR_WICK_RATIO=0.6
DISPLACEMENT_BODY_MULTIPLIER=2.0

# Logging
LOG_LEVEL=INFO

# Mode: live / paper
TRADING_MODE=paper
